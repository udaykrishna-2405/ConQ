# ConQ Backend Environment Variables
# Copy this to .env and fill in real values. Never commit .env.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_64_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# ── Gemini AI ──────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=4096

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
STACK_NAME=conq-stack

# ── DynamoDB Tables ────────────────────────────────────────────────────────────
DYNAMODB_USERS_TABLE=conq-users
DYNAMODB_CONTENT_TABLE=conq-content
DYNAMODB_PREDICTIONS_TABLE=conq-predictions
DYNAMODB_TRENDS_TABLE=conq-trends
DYNAMODB_ANALYTICS_TABLE=conq-analytics
DYNAMODB_AI_STUDIO_TABLE=conq-ai-studio
DYNAMODB_GROWTH_TABLE=conq-growth-intelligence
DYNAMODB_MONETIZATION_TABLE=conq-monetization
DYNAMODB_SCORECARD_TABLE=conq-creator-scorecard
DYNAMODB_SHIELD_TABLE=conq-content-shield
DYNAMODB_AUTOMATION_TABLE=conq-automation
# For local DynamoDB (e.g., dynamodb-local): uncomment below
# DYNAMODB_ENDPOINT=http://localhost:8000

# ── S3 ─────────────────────────────────────────────────────────────────────────
S3_REPORTS_BUCKET=conq-reports
S3_DATA_LAKE_BUCKET=conq-data-lake

# ── CloudFront ─────────────────────────────────────────────────────────────────
CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net

# ── SES ────────────────────────────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@conq.ai
SES_REPLY_TO_EMAIL=support@conq.ai

# ── Platform Integrations (optional) ──────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here

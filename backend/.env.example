# ConQ Backend Environment Variables
# ====================================
# Copy this file to .env and fill in values

# ── Node Environment ──
NODE_ENV=development

# ── JWT Configuration ──
# REQUIRED in production. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=1h

# ── CORS ──
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000

# ── AWS Configuration ──
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# ── DynamoDB Tables ──
DYNAMODB_USERS_TABLE=conq-users
DYNAMODB_CONTENT_TABLE=conq-content
DYNAMODB_PREDICTIONS_TABLE=conq-predictions
DYNAMODB_TRENDS_TABLE=conq-trends
DYNAMODB_ANALYTICS_TABLE=conq-analytics

# ── Cognito ──
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── SageMaker ──
SAGEMAKER_ENDPOINT_VIRALITY=conq-virality-endpoint

# ── S3 ──
S3_DATA_LAKE_BUCKET=conq-data-lake

# ── Redis (ElastiCache) ──
REDIS_HOST=
REDIS_PORT=6379

# ── Platform API Keys ──
YOUTUBE_API_KEY=
INSTAGRAM_API_KEY=

# ── Logging ──
LOG_LEVEL=info

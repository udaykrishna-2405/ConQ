# ConQ Frontend Environment Variables
# ======================================
# Copy this file to .env and fill in values.
# For local development, the defaults below work out of the box.
# For production (Vercel), set REACT_APP_API_BASE_URL to your Render backend URL.

# Backend API URL
# Local dev : http://localhost:3001
# Production: https://conq-backend.onrender.com  (replace with your Render URL)
REACT_APP_API_BASE_URL=http://localhost:3001

# AWS Cognito (optional — only needed if Cognito auth is enabled)
REACT_APP_COGNITO_USER_POOL_ID=
REACT_APP_COGNITO_CLIENT_ID=
REACT_APP_REGION=ap-south-1
